#!/bin/bash
# uninstall_init：用户点击卸载（还未真正删除文件）时触发
# 这里先尝试杀掉还在跑的 faststrm 进程，避免卸载时 app 目录仍被占用
set +e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_ROOT="${TRIM_APPDEST:-$(dirname "${SCRIPT_DIR}")}"

# 1. 优先读 PID_FILE（main 启动时已写入 TRIM_PKGVAR/app.pid），最可靠
PID_FILE="${TRIM_PKGVAR:-${APP_ROOT}/var}/app.pid"
if [ -r "${PID_FILE}" ]; then
  pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
  if [ -n "${pid}" ]; then
    kill -TERM "${pid}" 2>/dev/null || true
    # 等 5s，仍存活再 KILL
    for _ in 1 2 3 4 5; do
      kill -0 "${pid}" 2>/dev/null || break
      sleep 1
    done
    kill -KILL "${pid}" 2>/dev/null || true
  fi
  rm -f "${PID_FILE}" 2>/dev/null || true
fi

# 2. 兜底：pkill 匹配 ${APP_ROOT}/faststrm（覆盖 fallback 链全部路径：/faststrm, /app/faststrm, /bin/faststrm）
#    注意：main 用 nohup 启动，cmdline 是 `nohup /path/faststrm`，不能用 ^ 锚定，也不能用 -xf 精确匹配
for p in "${APP_ROOT}/faststrm" "${APP_ROOT}/app/faststrm" "${APP_ROOT}/bin/faststrm"; do
  if [ -n "${p}" ]; then
    pkill -f "${p}" 2>/dev/null || true
  fi
done

sleep 1
exit 0
