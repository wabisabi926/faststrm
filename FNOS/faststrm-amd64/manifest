appname               = faststrm
version = 0.9.4
display_name          = FastStrm
desc                  = 115 网盘 STRM 自动生成器。监控网盘变动实时生成 STRM，支持 Emby/Jellyfin/Infuse 直连播放，内置 Telegram 通知与 Emby 自动刷库。
platform              = x86
source       = thirdparty
maintainer    = wabisabi926
maintainer_url = https://github.com/wabisabi926/faststrm
distributor    = wabisabi926
distributor_url= https://github.com/wabisabi926/faststrm
desktop_applaunchname=faststrm.Application
service_port=8090
checkport=true
desktop_uidir         = ui
service_config_dir = /app_data/faststrm/config
service_data_dir   = /app_data/faststrm/data
service_log_dir    = /app_data/faststrm/logs
service_run_dir    = /app_data/faststrm/run
; 共享卷授权（对齐 qmediasync）：用户在应用管理 - 共享目录中勾选后，对应路径会被映射到沙箱并注入到 TRIM_DATA_SHARE_PATHS 环境变量
; 支持逗号分隔的卷根前缀 / 具体路径。下列声明覆盖飞牛常见的 /vol1~/vol4、群晖 /volume1~/volume4、UNRAID /mnt/user 等。
share_dirs         = /vol1,/vol2,/vol3,/vol4,/volume1,/volume2,/volume3,/volume4,/mnt/user,/mnt/ssd,/mnt/cache,/share,/public,/home

