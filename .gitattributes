# 强制所有 Shell 脚本使用 LF 换行，避免 Windows checkout 出 CRLF 导致 Linux 容器执行失败
*.sh         text eol=lf
*.bash       text eol=lf

# fNOS 回调脚本（无扩展名，但按路径匹配）
FNOS/**/cmd/* text eol=lf
FNOS/**/wizard/* text eol=lf

# Dockerfile / entrypoint
Dockerfile           text eol=lf
docker-entrypoint.sh text eol=lf

# 构建脚本
scripts/*.sh text eol=lf

# Go 源码保持 LF
*.go  text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# 前端配置
*.json  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# 二进制文件不做换行转换
*.png  binary
*.jpg  binary
*.ico  binary

# SPA 构建产物：由 Vite 编译、Go embed 内嵌，hash 文件名每次 build 都会变
# 保留在仓库中（裸 clone 需能直接 go build），但 diff 时静默忽略
internal/web/spa/** -diff -merge -text
