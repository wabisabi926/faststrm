# =============================================
# Fast Strm Docker Ignore
# 排除不必要的文件，加快构建速度
# =============================================

# Git
.git
.gitignore
.github

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# Node.js
frontend/node_modules
frontend/.next
frontend/.turbo
frontend/dist

# 配置文件
.env
.env.local
.env.*.local

# IDE
.vscode
.idea
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 临时文件
*.tmp
*.temp
test/
dist_all/

# 文档
*.md
!frontend/README.md
