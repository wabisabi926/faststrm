package web

// LifeEventsPage 生活事件日志页 —— 对齐 /life-events
// 展示 115 网盘文件操作事件日志（创建/删除/移动/重命名）
templ LifeEventsPage() {
	@AppShell("/life-events") {
		<div class="mx-auto max-w-5xl space-y-6">
			@PageHeader("生活事件", "115 网盘文件操作事件日志") {
				<button class="btn btn-outline" onclick="loadEvents()">刷新</button>
			}

			<div class="card">
				<div class="card-content">
					<div id="events-list" class="space-y-2">
						<p class="text-sm text-muted-foreground">加载中…</p>
					</div>
					<div id="events-pagination" class="mt-4 flex items-center justify-between text-xs text-muted-foreground">
						<span id="events-meta">--</span>
					</div>
				</div>
			</div>
		</div>

		<script>
			function getAuth() { return 'Bearer ' + (document.cookie.match('(^|;) ?token=([^;]*)')||[])[2]; }
			var eventsPage = 1;
			var eventsSize = 50;

			function typeLabel(t) {
				var map = { create: '新建', delete: '删除', move: '移动', rename: '重命名', 'folder-sync': '同步' };
				return map[t] || t;
			}
			function typeColor(t) {
				var map = {
					create: 'bg-green-50 text-green-700 border-green-200',
					delete: 'bg-red-50 text-red-700 border-red-200',
					move: 'bg-blue-50 text-blue-700 border-blue-200',
					rename: 'bg-amber-50 text-amber-700 border-amber-200',
					'folder-sync': 'bg-slate-50 text-slate-700 border-slate-200'
				};
				return map[t] || 'bg-slate-50 text-slate-700 border-slate-200';
			}

			function loadEvents() {
				var url = '/api/lifeEvents?page=' + eventsPage + '&size=' + eventsSize;
				fetch(url, { headers: { 'Authorization': getAuth() } })
					.then(function(r){ return r.json(); })
					.then(function(data){
						var el = document.getElementById('events-list');
						var meta = document.getElementById('events-meta');
						if (!el) return;
						var items = data.items || data.data?.items || [];
						var total = data.total || data.data?.total || items.length;
						if (meta) meta.textContent = '共 ' + total + ' 条 · 第 ' + eventsPage + ' 页';
						if (!items.length) { el.innerHTML = '<p class="text-sm text-muted-foreground">暂无事件记录</p>'; return; }
						var html = '';
						items.forEach(function(e) {
							var t = e.timestamp ? new Date(Number(e.timestamp)).toLocaleString() : '-';
							var success = e.success !== false;
							var path = e.filePath || e.localPath || '-';
							html += '<div class="flex items-start gap-3 py-2 border-b border-border last:border-0">' +
								'<span class="badge badge-outline ' + typeColor(e.eventType) + '">' + typeLabel(e.eventType) + '</span>' +
								'<div class="flex-1 min-w-0">' +
								'<div class="text-sm font-medium truncate">' + path + '</div>' +
								'<div class="text-xs text-muted-foreground">' + e.account + ' · ' + t + (e.message ? ' · ' + e.message : '') + '</div>' +
								'</div>' +
								'<span class="text-xs ' + (success ? 'text-green-600' : 'text-red-600') + '">' + (success ? '成功' : '失败') + '</span>' +
								'</div>';
						});
						el.innerHTML = html;
					}).catch(function(){
						var el = document.getElementById('events-list');
						if (el) el.innerHTML = '<p class="text-sm text-red-600">加载失败</p>';
					});
			}
			loadEvents();
		</script>
	}
}
