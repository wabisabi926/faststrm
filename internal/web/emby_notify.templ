package web

// EmbyNotifyPage Emby 通知配置页 —— 对齐 /emby-notify
templ EmbyNotifyPage() {
	@AppShell("/emby-notify") {
		<div class="mx-auto max-w-3xl space-y-6">
			@PageHeader("Emby 通知", "配置 Emby Server 连接，接收入库/删除/播放通知") {}

			<div class="card">
				<div class="card-header">
					<h2 class="card-title">Emby 连接</h2>
					<p class="card-desc">填写 Emby Server URL 和 API Key</p>
				</div>
				<div class="card-content space-y-4">
					<form id="emby-form" hx-post="/api/emby/settings" hx-swap="none" class="space-y-4">
						<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
							<div>
								<label class="label" for="emby-url">Emby URL</label>
								<input id="emby-url" name="url" class="input" placeholder="http://192.168.1.10:8096"/>
							</div>
							<div>
								<label class="label" for="emby-apikey">API Key</label>
								<input id="emby-apikey" name="apiKey" class="input" placeholder="在 Emby Dashboard → API Keys 获取"/>
							</div>
						</div>
						<div>
							<label class="label" for="emby-webhook-auth">Webhook Auth (可选)</label>
							<input id="emby-webhook-auth" name="webhookAuth" class="input" placeholder="Webhook 鉴权密钥"/>
						</div>

						<div class="space-y-2 pt-2">
							<h3 class="text-sm font-medium">通知事件</h3>
							<label class="flex items-center gap-2 text-sm cursor-pointer">
								<input type="checkbox" name="notifyMediaAdded" class="checkbox"/>
								入库通知
							</label>
							<label class="flex items-center gap-2 text-sm cursor-pointer">
								<input type="checkbox" name="notifyMediaRemoved" class="checkbox"/>
								删除通知
							</label>
							<label class="flex items-center gap-2 text-sm cursor-pointer">
								<input type="checkbox" name="notifyPlayback" class="checkbox"/>
								播放通知
							</label>
						</div>

						<div class="space-y-2 pt-2">
							<h3 class="text-sm font-medium">反向删除同步</h3>
							<label class="flex items-center gap-2 text-sm cursor-pointer">
								<input type="checkbox" name="syncDeleteEnabled" class="checkbox"/>
								启用 Emby → 115 反向删除同步
							</label>
							<label class="flex items-center gap-2 text-sm cursor-pointer">
								<input type="checkbox" name="syncDeleteDryRun" class="checkbox"/>
								Dry-run 模式（仅记录不删除）
							</label>
						</div>

						<div class="flex gap-2 pt-2">
							<button type="submit" class="btn btn-default">保存配置</button>
							<button type="button" class="btn btn-outline" onclick="testEmby()">测试连接</button>
						</div>
					</form>
					<div id="emby-result"></div>
				</div>
			</div>
		</div>

		<script>
			function getAuth() { return 'Bearer ' + (document.cookie.match('(^|;) ?token=([^;]*)')||[])[2]; }
			function testEmby() {
				fetch('/api/emby/test-connection', { method: 'POST', headers: { 'Authorization': getAuth(), 'Content-Type': 'application/json' }, body: '{}' })
					.then(function(r){ return r.json(); })
					.then(function(d){
						var el = document.getElementById('emby-result');
						if (el) el.innerHTML = d.success !== false
							? '<div class="text-sm text-green-600 mt-2">Emby 连接成功</div>'
							: '<div class="text-sm text-red-600 mt-2">' + (d.error || '连接失败') + '</div>';
					}).catch(function(){});
			}
			(function() {
				fetch('/api/emby/settings', { headers: { 'Authorization': getAuth() } })
					.then(function(r){ return r.json(); })
					.then(function(data){
						if (data.url) document.getElementById('emby-url').value = data.url;
						if (data.apiKey) document.getElementById('emby-apikey').value = data.apiKey;
						if (data.webhookAuth) document.getElementById('emby-webhook-auth').value = data.webhookAuth;
						var form = document.getElementById('emby-form');
						if (data.notifyMediaAdded) form.querySelector('[name=notifyMediaAdded]').checked = true;
						if (data.notifyMediaRemoved) form.querySelector('[name=notifyMediaRemoved]').checked = true;
						if (data.notifyPlayback) form.querySelector('[name=notifyPlayback]').checked = true;
						if (data.syncDeleteEnabled) form.querySelector('[name=syncDeleteEnabled]').checked = true;
						if (data.syncDeleteDryRun) form.querySelector('[name=syncDeleteDryRun]').checked = true;
					}).catch(function(){});

				document.body.addEventListener('htmx:afterRequest', function(evt) {
					if (!evt.detail.requestConfig) return;
					if (evt.detail.requestConfig.path !== '/api/emby/settings') return;
					var r = document.getElementById('emby-result');
					if (!r) return;
					try {
						var data = JSON.parse(evt.detail.xhr.responseText);
						r.innerHTML = evt.detail.successful
							? '<div class="text-sm text-green-600 mt-2">保存成功</div>'
							: '<div class="text-sm text-red-600 mt-2">' + (data.error || '保存失败') + '</div>';
					} catch(e) {}
				});
			})();
		</script>
	}
}
