package web

// AccountAlertsPage 账户状态告警页 —— 对齐 /account-alerts
// 配置告警开关 + 展示各账号实时状态
templ AccountAlertsPage() {
	@AppShell("/account-alerts") {
		<div class="mx-auto max-w-3xl space-y-6">
			@PageHeader("账户状态告警", "监控网盘账户登录态，异常时推送 Telegram 通知") {}

			<!-- 告警配置 -->
			<div class="card">
				<div class="card-header">
					<h2 class="card-title">告警配置</h2>
					<p class="card-desc">选择需要通知的事件类型</p>
				</div>
				<div class="card-content space-y-4">
					<form id="alerts-form" hx-put="/api/notify/alerts" hx-swap="none" class="space-y-4">
						<label class="flex items-center gap-2 text-sm cursor-pointer">
							<input type="checkbox" name="enabled" class="checkbox" id="alerts-enabled"/>
							启用告警
						</label>
						<label class="flex items-center gap-2 text-sm cursor-pointer">
							<input type="checkbox" name="onError" class="checkbox" checked/>
							账户异常时通知
						</label>
						<label class="flex items-center gap-2 text-sm cursor-pointer">
							<input type="checkbox" name="onRecover" class="checkbox" checked/>
							账户恢复时通知
						</label>
						<div>
							<button type="submit" class="btn btn-default">保存配置</button>
						</div>
					</form>
					<div id="alerts-result"></div>
				</div>
			</div>

			<!-- 账号状态列表 -->
			<div class="card">
				<div class="card-header">
					<h2 class="card-title">账号状态</h2>
					<p class="card-desc">实时检测各账户登录态</p>
				</div>
				<div class="card-content">
					<div id="alerts-status-list"
						hx-get="/api/account/status"
						hx-trigger="load, every 30s"
						hx-swap="none">
						<p class="text-sm text-muted-foreground">加载中…</p>
					</div>
				</div>
			</div>
		</div>

		<script>
			(function() {
				// 加载已有配置
				document.body.addEventListener('htmx:afterRequest', function(evt) {
					if (!evt.detail.requestConfig) return;
					var path = evt.detail.requestConfig.path || '';
					try {
						var data = JSON.parse(evt.detail.xhr.responseText);
						if (path === '/api/notify/alerts' && evt.detail.requestConfig.verb === 'get') {
							var en = document.getElementById('alerts-enabled');
							if (en && data.enabled !== undefined) en.checked = data.enabled;
						}
						if (path === '/api/notify/alerts' && evt.detail.requestConfig.verb === 'put') {
							var r = document.getElementById('alerts-result');
							if (r) r.innerHTML = evt.detail.successful
								? '<div class="text-sm text-green-600 mt-2">保存成功</div>'
								: '<div class="text-sm text-red-600 mt-2">保存失败</div>';
						}
						if (path === '/api/account/status') {
							var list = data.results || [];
							var el = document.getElementById('alerts-status-list');
							if (!el) return;
							if (!list.length) { el.innerHTML = '<p class="text-sm text-muted-foreground">暂无账号</p>'; return; }
							var html = '<div class="space-y-2">';
							list.forEach(function(s) {
								var color = s.status === 'ok' ? 'text-green-600' : s.status === 'error' ? 'text-red-600' : 'text-muted-foreground';
								var label = s.status === 'ok' ? '正常' : s.status === 'error' ? '异常' : '未知';
								html += '<div class="flex items-center justify-between py-2 border-b border-border last:border-0">' +
									'<span class="text-sm font-medium">' + s.name + '</span>' +
									'<span class="text-sm ' + color + '">' + label + (s.message ? ' (' + s.message + ')' : '') + '</span>' +
									'</div>';
							});
							html += '</div>';
							el.innerHTML = html;
						}
					} catch(e) {}
				});
				// 初始加载配置
				fetch('/api/notify/alerts', { headers: { 'Authorization': 'Bearer ' + (document.cookie.match('(^|;) ?token=([^;]*)')||[])[2] } })
					.then(function(r){ return r.json(); })
					.then(function(data){
						var en = document.getElementById('alerts-enabled');
						if (en && data.enabled !== undefined) en.checked = data.enabled;
					}).catch(function(){});
			})();
		</script>
	}
}
