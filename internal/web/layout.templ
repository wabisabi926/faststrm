package web

import "fmt"

// ===== 侧边栏数据结构：严格对齐 frontend/src/components/app-sidebar.tsx =====

// SidebarGroup 侧边栏分组（带标签）
type SidebarGroup struct {
	Label string
	Items []NavItem
}

// NavItem 单个导航项
type NavItem struct {
	Href  string
	Label string
	Icon  string // icon key
}

// appVersion 显示在 sidebar footer
const appVersion = "0.1.0"

// navGroups 与原始前端完全一致：主菜单 / 通知 / 日志
func navGroups() []SidebarGroup {
	return []SidebarGroup{
		{
			Label: "主菜单",
			Items: []NavItem{
				{Href: "/account", Label: "账户", Icon: "inbox"},
				{Href: "/task", Label: "任务", Icon: "listChecks"},
				{Href: "/settings", Label: "设置", Icon: "settings"},
			},
		},
		{
			Label: "通知",
			Items: []NavItem{
				{Href: "/account-alerts", Label: "账户状态", Icon: "shieldAlert"},
				{Href: "/tg-notify", Label: "TG 通知", Icon: "bot"},
				{Href: "/emby-notify", Label: "Emby 通知", Icon: "bell"},
			},
		},
		{
			Label: "日志",
			Items: []NavItem{
				{Href: "/history", Label: "任务历史", Icon: "history"},
				{Href: "/life-events", Label: "生活事件", Icon: "activity"},
			},
		},
	}
}

// ===== Layout =====

// Layout 是所有页面的基础 HTML 外壳，统一加载静态资源
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/tailwind.css"/>
			<link rel="icon" type="image/png" href="/static/logo.png"/>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body class="antialiased">
			{ children... }
		</body>
	</html>
}

// ===== AppShell：登录后的外壳，严格对齐 LayoutWrapper + AppSidebar =====
templ AppShell(activePath string) {
	@Layout("Fast Strm") {
		<div class="flex min-h-screen w-full flex-col bg-background text-foreground">
			<div class="flex flex-1">
				<!-- ===== Sidebar（对齐 shadcn/ui Sidebar，宽 280px / 16rem） ===== -->
				<aside class="hidden md:flex md:flex-col md:w-[280px] shrink-0 border-r border-sidebar-border bg-sidebar text-sidebar-foreground">
					<!-- 品牌区：logo + 名称 + 副标题 -->
					<div class="p-4 border-b border-sidebar-border/50">
						<div class="flex items-center gap-3">
							<img src="/static/logo.png" alt="Fast Strm Logo" width="36" height="36" class="flex-shrink-0" style="width:36px;height:36px"/>
							<div class="flex flex-col">
								<span class="text-xl font-bold text-foreground">Fast Strm</span>
								<span class="text-xs text-muted-foreground">更快、更强、更硬</span>
							</div>
						</div>
					</div>

					<!-- 菜单内容：三组分组视觉节奏完全对齐 frontend shadcn/ui SidebarGroup -->
					<nav class="flex-1 px-3 py-2 space-y-0 overflow-y-auto">
						for _, g := range navGroups() {
							<div class="sidebar-group-label">{ g.Label }</div>
							<!-- 统一：首项 mt-0 其余 space-y-1，每组底部 pb-1 保证块感一致，不因项数多或少疏密不一 -->
							<div class="mt-0.5 space-y-1 pb-1">
								for _, item := range g.Items {
									@sidebarMenuItem(item, activePath)
								}
							</div>
						}
					</nav>

					<!-- 分隔线 + Footer：GitHub + 版本 -->
					<div class="border-t border-sidebar-border/50 mx-3 mt-2"></div>
					<div class="px-2 py-2 mt-1 mb-1">
						<div class="flex items-center justify-between mx-1 text-xs">
							<a
								href="https://github.com/wabisabi926/faststrm"
								target="_blank"
								rel="noreferrer"
								class="inline-flex items-center gap-1 text-muted-foreground hover:text-foreground transition-colors px-2 py-1 rounded-md hover:bg-sidebar-accent"
							>
								@icon("github", "w-4 h-4")
								<span>GitHub</span>
							</a>
							<span class="px-2 py-0.5 rounded bg-muted text-foreground/80">v{ appVersion }</span>
						</div>
					</div>
				</aside>

				<!-- ===== 移动端侧边栏遮罩（点击关闭抽屉） ===== -->
				<div class="sidebar-mobile-backdrop" onclick="closeMobileSidebar()" aria-hidden="true"></div>

				<!-- ===== 主内容区 ===== -->
				<div class="flex flex-col w-full min-w-0 flex-1">
					<!-- Top bar：sidebar trigger + wiki link + settings menubar -->
					<header class="w-full border-b border-border flex items-center gap-3 p-2 flex-nowrap shrink-0">
						<!-- Sidebar trigger (仅小屏可见，用自定义类保证样式必生效) -->
						<button
							type="button"
							class="sidebar-toggle-btn"
							aria-label="打开侧边栏"
							aria-expanded="false"
							onclick="toggleMobileSidebar()"
						>
							@icon("menu", "h-5 w-5")
						</button>

						<!-- 右侧：Wiki + Settings（Menubar下拉） -->
						<div class="ml-auto flex items-center gap-1">
							<a
								href="https://github.com/wabisabi926/faststrm/wiki"
								target="_blank"
								rel="noreferrer"
								class="inline-flex items-center justify-center rounded p-1 hover:bg-accent h-9 w-9"
								aria-label="Wiki"
								title="Wiki"
							>
								@icon("bookOpen", "h-5 w-5")
							</a>
							<!-- Menubar：Settings 下拉 -->
							<div class="menubar" id="menubar">
								<button
									type="button"
									class="menubar-trigger"
									aria-haspopup="menu"
									aria-expanded="false"
									onclick="toggleMenu(event)"
								>
									@icon("settings", "m-1 h-5 w-5")
								</button>
								<div
									class="menubar-content hidden"
									id="menubar-content"
									role="menu"
								>
									<div
										class="menubar-item danger"
										role="menuitem"
										onclick="doLogout()"
									>Sign Out</div>
								</div>
							</div>
						</div>
					</header>

					<!-- 内容区：p-[20px] -->
					<main class="flex-1 p-[20px] overflow-y-auto">
						{ children... }
					</main>
				</div>
			</div>
		</div>

		<!-- ===== 全局脚本 ===== -->
		<script>
			// ===== 移动端侧边栏抽屉开关（C1：不依赖 Tailwind md:hidden 扫描结果）=====
			function toggleMobileSidebar() {
				var open = document.body.classList.toggle('sidebar-mobile-open');
				var btn = document.querySelector('.sidebar-toggle-btn');
				if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
				// 关闭时也顺手关掉 menubar 下拉
				if (!open) {
					var mc = document.getElementById('menubar-content');
					var mt = document.getElementById('menubar')?.querySelector('.menubar-trigger');
					if (mc) mc.classList.add('hidden');
					if (mt) mt.setAttribute('aria-expanded', 'false');
				}
			}
			function closeMobileSidebar() {
				if (!document.body.classList.contains('sidebar-mobile-open')) return;
				document.body.classList.remove('sidebar-mobile-open');
				var btn = document.querySelector('.sidebar-toggle-btn');
				if (btn) btn.setAttribute('aria-expanded', 'false');
			}
			// ESC 关闭移动端侧边栏
			document.addEventListener('keydown', function(e){
				if (e.key === 'Escape') closeMobileSidebar();
			});
			// 窗口拉大到桌面端时，自动清理 mobile open 状态
			function _normalizeSidebarState() {
				try {
					if (window.matchMedia && window.matchMedia('(min-width: 768px)').matches) {
						closeMobileSidebar();
					}
				} catch(_) {}
			}
			window.addEventListener('resize', _normalizeSidebarState);
			window.addEventListener('orientationchange', _normalizeSidebarState);

			// JWT cookie 读写
			function getCookie(name) {
				var m = document.cookie.match('(^|;) ?' + name + '=([^;]*)(;|$)');
				return m ? m[2] : null;
			}
			// 登录态检查
			if (!getCookie('token')) {
				window.location.href = '/login';
			}
			// 为所有 HTMX 请求注入 Authorization 头
			document.body.addEventListener('htmx:configRequest', function(evt) {
				var t = getCookie('token');
				if (t) evt.detail.headers['Authorization'] = 'Bearer ' + t;
			});
			// 处理 HTMX 401：统一跳转登录
			document.body.addEventListener('htmx:responseError', function(evt) {
				if (evt.detail.xhr.status === 401) {
					window.location.href = '/login';
				}
			});

			// Menubar 下拉开关
			function toggleMenu(e) {
				e.stopPropagation();
				var el = document.getElementById('menubar-content');
				var t = document.getElementById('menubar').querySelector('.menubar-trigger');
				var opened = !el.classList.contains('hidden');
				el.classList.toggle('hidden');
				t.setAttribute('aria-expanded', opened ? 'false' : 'true');
			}
			// 点击外部关闭
			document.addEventListener('click', function() {
				var el = document.getElementById('menubar-content');
				if (el && !el.classList.contains('hidden')) el.classList.add('hidden');
				var t = document.getElementById('menubar').querySelector('.menubar-trigger');
				if (t) t.setAttribute('aria-expanded', 'false');
			});

			// 登出
			function doLogout() {
				// 发送登出请求（忽略失败，一定清 cookie）
				try {
					var t = getCookie('token');
					if (t) fetch('/api/auth/logout', { method: 'POST', headers: { 'Authorization': 'Bearer ' + t } }).catch(function(){});
				} catch(e) {}
				document.cookie = 'token=;path=/;max-age=0';
				window.location.href = '/login';
			}
		</script>
	}
}

// sidebarMenuItem 渲染单个侧栏菜单项
templ sidebarMenuItem(item NavItem, activePath string) {
	<a href={ item.Href }
		class={
			"flex items-center gap-2 h-9 px-3 rounded-md text-sm transition-colors " +
			sidebarActiveClass(item.Href == activePath)
		}
	>
		@icon(item.Icon, "w-4 h-4 shrink-0")
		<span class="truncate">{ item.Label }</span>
	</a>
}

func sidebarActiveClass(active bool) string {
	if active {
		return "sidebar-active font-medium"
	}
	return "text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"
}

// ===== 图标库（内联 SVG stroke 2，匹配 lucide-react） =====
templ icon(key, cls string) {
	switch key {
	case "menu":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/>
		</svg>
	case "settings":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
			<circle cx="12" cy="12" r="3"/>
		</svg>
	case "bookOpen":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
			<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
		</svg>
	case "github":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
			<path d="M9 18c-4.51 2-5-2-7-2"/>
		</svg>
	case "inbox":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/>
			<path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>
		</svg>
	case "listChecks":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="m3 17 2 2 4-4"/>
			<path d="m3 7 2 2 4-4"/>
			<path d="M13 6h8"/>
			<path d="M13 12h8"/>
			<path d="M13 18h8"/>
		</svg>
	case "shieldAlert":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
			<path d="M12 8v4"/><path d="M12 16h.01"/>
		</svg>
	case "bot":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<rect width="18" height="10" x="3" y="11" rx="2"/>
			<circle cx="12" cy="5" r="2"/>
			<path d="M12 7v4"/><line x1="8" y1="16" x2="8" y2="16"/>
			<line x1="16" y1="16" x2="16" y2="16"/>
		</svg>
	case "bell":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
			<path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
		</svg>
	case "history":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
			<path d="M3 3v5h5"/><path d="M12 7v5l4 2"/>
		</svg>
	case "activity":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
		</svg>
	case "user":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
			<circle cx="12" cy="7" r="4"/>
		</svg>
	case "key":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="7.5" cy="15.5" r="3.5"/>
			<path d="m21 2-9.6 9.6"/><path d="m15.5 7.5 3 3L22 7l-3-3"/>
		</svg>
	case "plus":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M5 12h14"/><path d="M12 5v14"/>
		</svg>
	case "refreshCw":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
			<path d="M21 3v5h-5"/>
			<path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
			<path d="M8 16H3v5"/>
		</svg>
	case "edit":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
			<path d="m15 5 4 4"/>
		</svg>
	case "trash2":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
			<path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
			<line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/>
		</svg>
	case "checkCircle":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
			<path d="m9 11 3 3L22 4"/>
		</svg>
	case "xCircle":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M18 6 6 18"/><path d="m6 6 12 12"/><circle cx="12" cy="12" r="10"/>
		</svg>
	case "alertCircle":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="12" cy="12" r="10"/>
			<line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
		</svg>
	case "alertTriangle":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
			<path d="M12 9v4"/><path d="M12 17h.01"/>
		</svg>
	case "helpCircle":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="12" cy="12" r="10"/>
			<path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
			<path d="M12 17h.01"/>
		</svg>
	case "loader2":
		<svg class={ cls + " animate-spin" } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M21 12a9 9 0 1 1-6.219-8.56"/>
		</svg>
	case "play":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<polygon points="6 3 20 12 6 21 6 3"/>
		</svg>
	case "square":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<rect width="18" height="18" x="3" y="3" rx="2"/>
		</svg>
	case "fileText":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
			<path d="M14 2v4a2 2 0 0 0 2 2h4"/>
			<path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>
		</svg>
	case "clock":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="12" cy="12" r="10"/>
			<polyline points="12 6 12 12 16 14"/>
		</svg>
	case "lifebuoy":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/>
			<path d="m4.93 4.93 3.54 3.54"/><path d="m15.53 15.53 3.54 3.54"/>
			<path d="m4.93 19.07 3.54-3.54"/><path d="m15.53 8.47 3.54-3.54"/>
		</svg>
	case "shield":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
		</svg>
	case "userCog":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M14 19.439V18.5a2.5 2.5 0 0 0-2.5-2.5h-5A2.5 2.5 0 0 0 4 18.5v.939"/>
			<circle cx="9" cy="10" r="4"/>
			<circle cx="17.5" cy="16.5" r=".5"/>
			<path d="M19 14.5a1.5 1.5 0 0 1 1 1.38V16a1 1 0 0 0 1 1h1a1 1 0 0 1 0 2h-1a1 1 0 0 0-1 1v.12a1.5 1.5 0 0 1-2 0V19a1 1 0 0 0-1-1h-1a1 1 0 0 1 0-2h1a1 1 0 0 0 1-1v-.12a1.5 1.5 0 0 1 1-1.38z"/>
		</svg>
	case "folderOpen":
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="m6 14 1.45-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H18a2 2 0 0 1 2 2v2"/>
		</svg>
	default:
		<svg class={ cls } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="12" cy="12" r="10"/>
		</svg>
	}
}

// ===== 通用组件 =====

// PageHeader 统一页面标题区：h1 + 副标题 + 右侧操作按钮（通过 children 传入）
templ PageHeader(title, subtitle string) {
	<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-6">
		<div>
			<h1 class="text-2xl font-semibold text-foreground">{ title }</h1>
			if subtitle != "" {
				<p class="text-muted-foreground mt-1">{ subtitle }</p>
			}
		</div>
		<div class="page-header-actions flex gap-2">
			{ children... }
		</div>
	</div>
}

// EmptyState 空状态（居中，灰图标 + 文字）
templ EmptyState(iconKey, title, desc string) {
	<div class="text-center py-12 bg-gray-50 rounded-lg border border-border" style="background-color: color-mix(in oklab, var(--muted) 30%, white);">
		<div class="mx-auto h-12 w-12 text-muted-foreground flex items-center justify-center">
			@icon(iconKey, "h-12 w-12")
		</div>
		<h3 class="mt-4 text-lg font-medium text-foreground">{ title }</h3>
		if desc != "" {
			<p class="mt-2 text-muted-foreground">{ desc }</p>
		}
	</div>
}

// fmtf 格式化数字为人类可读（辅助）
func fmtf(n int64) string {
	return fmt.Sprintf("%d", n)
}
