package web

// LoginPage 登录页 —— 严格对齐 faststrm-main 的 frontend/src/app/login/page.tsx
//
// 原版结构：
//   bg-gray-100 满屏 → max-w-md 白卡片 → rounded-2xl shadow-lg
//   顶部 logo.png (64x64) + "登录" 标题
//   用户名 / 密码 两个字段 + 全宽"登录"按钮
templ LoginPage() {
	@Layout("登录") {
		<div class="flex h-screen items-center justify-center" style="background-color: #f3f4f6;">
			<div class="w-full max-w-md bg-white p-8 rounded-2xl shadow-lg">
				<div class="flex flex-col items-center mb-6">
					<img
						src="/static/logo.png"
						alt="Fast Strm Logo"
						width="64"
						height="64"
						class="mb-4"
						style="width: 64px; height: 64px;"
					/>
					<h1 class="text-2xl font-bold text-center text-foreground">登录</h1>
				</div>

				<form
					hx-post="/api/auth/login"
					hx-target="#login-alert"
					hx-swap="innerHTML"
					hx-headers='{"Accept": "application/json"}'
					class="space-y-4"
				>
					<div class="space-y-1">
						<label for="username" class="label">用户名</label>
						<input
							id="username"
							name="username"
							type="text"
							class="input"
							placeholder="请输入用户名（默认：admin）"
							autocomplete="username"
							required
						/>
					</div>

					<div class="space-y-1">
						<label for="password" class="label">密码</label>
						<input
							id="password"
							name="password"
							type="password"
							class="input"
							placeholder="请输入密码（默认：admin）"
							autocomplete="current-password"
							required
						/>
					</div>

					<div id="login-alert"></div>

					<button type="submit" class="btn btn-default w-full mt-2">
						登录
					</button>
				</form>
			</div>
		</div>

		<script>
			// 处理登录响应：后端返回 { token, user } → 跳转 /
			// 失败 { error } → 显示错误
			document.body.addEventListener('htmx:afterRequest', function(evt) {
				if (evt.detail.requestConfig.path !== '/api/auth/login') return;
				try {
					var data = JSON.parse(evt.detail.xhr.responseText);
					var alertDiv = document.getElementById('login-alert');
					if (data.token) {
						if (alertDiv) alertDiv.innerHTML = '';
						window.location.href = '/';
					} else if (data.error) {
						if (alertDiv) {
							alertDiv.innerHTML =
								'<div class="px-4 py-2.5 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">'
								+ data.error + '</div>';
						}
					}
				} catch (e) {
					console.error('login parse failed:', e);
				}
			});
		</script>
	}
}
